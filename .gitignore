.pnpm-store
.eslintcache

# compiled output
node_modules
**/node_modules
dist
**/dist
dist-electron
**/dist-electron
release
**/release
unpackage
**/unpackage
target
**/target
**/*.tsbuildinfo
*.local

# Tests
**/tests/**/coverage/
# jest coverage 输出（各 app/package 的 coverageDirectory 产物）
**/coverage/
**/coverage-e2e/
**/coverage-merged/

# OS
.DS_Store

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv 策略：.env.* / .env.example 为平台配置，入库跟踪
# 排除 .env 文件，避免敏感信息泄露；机器级敏感覆盖统一用 .local 后缀（由上方 *.local 规则忽略）
.env

# logs
**/logs
**/*.log
**/*.log*

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Electron 构建产物
**/release

# husky auto-generated runtime dir (hook files themselves are committed)
.husky/_

# Prisma 生成物（prisma generate 产物，build 链重新生成）
apps/nestjs-server/src/generated/

# Turborepo 本地缓存（默认在 node_modules/.cache/turbo，此为自定义缓存目录兜底）
.turbo
