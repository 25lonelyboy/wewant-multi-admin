# docker compose 服务变量（复制为 .env 后填写）
POSTGRES_PASSWORD = change_me
# 业务缓存 Redis 认证口令（compose `:?` 强校验必填；与队列 Redis 是两个实例，互不影响）
REDIS_PASSWORD = change_me_redis
# 首次启动 seed 的超管口令（已存在超管时不生效、不覆盖）
ADMIN_INIT_PASSWORD = change_me_admin

# Nestjs 数据库连接（compose 内部使用服务名 postgres 作为 host）
DATABASE_URL = postgresql://postgres:change_me@postgres:5432/multi_admin?schema=public
# Redis 连接（compose 内部使用服务名 redis 作为 host；空用户名 ⇒ default 用户，口令即 REDIS_PASSWORD）
REDIS_URL = redis://:change_me_redis@redis:6379
# MQTT 接入（compose 内部使用服务名 emqx 作为 host；本地直接起 server 时可省，缺省 mqtt://127.0.0.1:1883）
MQTT_URL = mqtt://emqx:1883
# 订阅端 clientId（固定才能配合 clean=false 用上持久会话）/ 会话是否干净起始（true 用于 e2e 甩掉上轮积压）/ 持久会话过期秒数
MQTT_CLIENT_ID = wewant-iot-subscriber
MQTT_CLEAN_SESSION = false
MQTT_SESSION_EXPIRY_SECONDS = 86400
# 队列 Redis（compose 内部使用服务名 redis-queue 作为 host；与上面的业务缓存是两个实例）
QUEUE_REDIS_URL = redis://redis-queue:6379
# 队列不可达时订阅端落本地的目录与上限（字节）；超上限即停订阅 + 告警，不静默丢数据
IOT_SPILL_DIR = /var/lib/wewant-spill
IOT_SPILL_MAX_BYTES = 268435456
# 单条上行报文字节上限（应用层 256 KiB）；EMQX 默认 1 MB 作硬顶，留出中间段以便应用侧计数
IOT_MAX_MESSAGE_BYTES = 262144
# 时序库（compose 内部使用服务名 tdengine 作为 host；6041 是 taosAdapter，REST 与 WebSocket 同端口）
TDENGINE_URL = ws://root:taosdata@tdengine:6041
# 消费者 iot-worker：TDengine 连接池大小（2~4）与期望的服务器时区（窗口对齐靠它，不匹配即启动失败）
TDENGINE_CONNECTIONS = 2
TDENGINE_TIMEZONE = Asia/Shanghai
# 攒批：条数上限（≤32767）/ 等待上限 ms / 并发（同时是"一批最多攒多少条"）
INGEST_BATCH_SIZE = 500
INGEST_FLUSH_INTERVAL_MS = 2000
INGEST_CONCURRENCY = 500
# 降采样环：开关（false 只跑消费环）与每次重算的已闭合窗口数 K
DOWNSAMPLE_ENABLED = true
DOWNSAMPLE_LOOKBACK_WINDOWS = 3
# 事件时间戳边界（毫秒）：最多超前处理时刻 +24 h / 最多落后 −90 d，闭区间；超界拒收并计数
INGEST_TS_MAX_FUTURE_MS = 86400000
INGEST_TS_MAX_PAST_MS = 7776000000
# EMQX Dashboard 初始密码：仅在数据卷为空时生效，改动后需 pnpm ops:env-down --clean 重建卷
EMQX_DASHBOARD_PASSWORD = change_me_emqx
# JWT（P3）：ACCESS/REFRESH 必须使用不同密钥且 ≥32 字符；TTL 文法 数字+s|m|h|d
JWT_ACCESS_SECRET = your_32_char_minimum_access_secret_here
JWT_REFRESH_SECRET = your_32_char_minimum_refresh_secret_here
# 请求体大小限制（express json 格式：1mb / 500kb 等）
BODY_LIMIT = 1mb
UPLOAD_BODY_LIMIT = 10mb
# Prisma 慢查询阈值（ms）；连接池最大连接数；全量查询日志开关（排障临时用）
PRISMA_SLOW_QUERY_MS = 500
DATABASE_POOL_MAX = 20
PRISMA_QUERY_LOG = false
