{
  "extends": "@multi-admin/tsconfig/web.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "jsxImportSource": "vue",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@build/*": ["./build/*"]
    },
    "types": [
      "node",
      "vite/client",
      "element-plus/global",
      "@pureadmin/table/volar",
      "unplugin-icons/types/vue",
      "@pureadmin/descriptions/volar"
    ]
  },
  "include": ["src/utils/tree.ts", "types/*.d.ts"]
}
