{
  "extends": "@multi-admin/tsconfig/web.json",
  "compilerOptions": {
    "noEmit": true,
    "jsxImportSource": "vue",
    "sourceMap": true,
    "allowJs": false,
    "noImplicitThis": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@build/*": ["./build/*"]
    },
    "types": [
      "node",
      "vite/client",
      "element-plus/global",
      "@pureadmin/table/volar",
      "unplugin-icons/types/vue",
      "@pureadmin/descriptions/volar"
    ]
  },
  "include": [
    "mock/*.ts",
    "build/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "types/*.d.ts",
    "vite.config.ts"
  ],
  "exclude": ["dist", "**/*.js", "node_modules"]
}
