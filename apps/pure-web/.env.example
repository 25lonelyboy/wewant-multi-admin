# 平台本地运行端口
VITE_PORT = 8848

# 是否隐藏首页 隐藏 true 不隐藏 false
VITE_HOME_HIDDEN = false

# 开发环境读取配置文件路径
VITE_PUBLIC_PATH = /

# 路由历史模式（Hash 传 "hash"、HTML5 传 "h5"）
VITE_ROUTER_HISTORY = "hash"

# 是否启用本地 mock（vite-plugin-mock）；接入真实后端后设置为 false
VITE_MOCK = true

# 后端 API 地址（联调真实后端时填写，如 http://localhost:3000）
VITE_API_BASE =
